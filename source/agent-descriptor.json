{
  "format": "agent-descriptor-v1",
  "agent_version": "0.2.6",
  "name": "Inspect",
  "summary": "Reads an outside agent's code on GitHub at one commit, without running any of it, and reports what it does and how safe it is.",
  "does": "Inspect reads an outside agent's code in a public GitHub repository at one commit, without running any of it, and hands back an inspection report on what the agent does and how safe it is: a list of findings in eight sections, each citing a file and line at the commit. Scripts collect the facts; a model writes only the judgments, and each judgment cites the facts it rests on. It gives no verdict on bringing the agent in and judges no fit with anyone's plan.",
  "offerings": [
    {
      "id": "inspect-a-repository",
      "name": "Inspect a repository",
      "does": "Inspects one public GitHub repository at one commit and hands back the inspection report, a copy of it to read, the dependency list and a short summary.",
      "inputs": [
        {
          "name": "repository",
          "kind": "url",
          "required": true,
          "given_by": "either",
          "about": "The public GitHub repository to inspect, as its address or as owner and name, such as langchain-ai/design-agent."
        },
        {
          "name": "commit",
          "kind": "identifier",
          "required": true,
          "given_by": "either",
          "about": "The commit to inspect, as its digest of 7 to 40 characters, such as 86d8f66; a commit's address on GitHub gives the repository and the commit at once."
        }
      ],
      "outputs": [
        {
          "name": "sbom",
          "kind": "application/vnd.cyclonedx+json",
          "when": "per_task",
          "about": "The dependency list as a CycloneDX 1.5 bill of materials, made by rule and never by the model: every component with its version, its package URL and where it was read."
        },
        {
          "name": "inspection",
          "kind": "application/vnd.agentmesh.inspection-report+json",
          "when": "per_task",
          "about": "The inspection report in the inspection-report-v1 format: the repository and commit, the eight sections, the findings in section order, the judgments held back with why, the facts the findings cite, and what the job used. While the job runs, a working copy of it with the findings so far is posted under the same name, marked partial.",
          "schema": {
            "title": "The inspection report (inspection-report-v1)",
            "type": "object",
            "required": [
              "format",
              "repository",
              "commit",
              "inspected_at",
              "inspector",
              "sections",
              "findings",
              "held_back",
              "facts",
              "counts"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "const": "inspection-report-v1"
              },
              "partial": {
                "type": "object",
                "description": "only on the working copy posted while the job runs, never on the delivered report: the stage the job is at, how many findings so far, how many are left out of this copy to keep it one piece, and whether their words are",
                "required": [
                  "stage",
                  "findings_so_far",
                  "omitted",
                  "says_left_out"
                ],
                "additionalProperties": false,
                "properties": {
                  "stage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "findings_so_far": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "omitted": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "says_left_out": {
                    "type": "boolean"
                  }
                }
              },
              "repository": {
                "type": "object",
                "required": [
                  "owner",
                  "name",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              },
              "commit": {
                "type": "object",
                "required": [
                  "sha",
                  "checked"
                ],
                "additionalProperties": false,
                "properties": {
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "checked": {
                    "type": "boolean",
                    "description": "true when the archive's own header named this digest"
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "inspected_at": {
                "type": "string",
                "format": "date-time"
              },
              "inspector": {
                "type": "object",
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "const": "inspect"
                  },
                  "version": {
                    "type": "string"
                  }
                }
              },
              "sections": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "number",
                    "key",
                    "title"
                  ],
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    },
                    "key": {
                      "enum": [
                        "at-a-glance",
                        "what-was-inspected",
                        "what-it-does",
                        "how-it-works",
                        "what-it-connects-to",
                        "what-it-can-do-on-its-own",
                        "risks",
                        "tests-and-what-inspect-could-not-tell"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              },
              "findings": {
                "type": "array"
              },
              "held_back": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "section",
                    "title",
                    "why"
                  ],
                  "properties": {
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    },
                    "title": {
                      "type": "string"
                    },
                    "says": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    }
                  }
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Fact"
                }
              },
              "dependencies": {
                "type": "object",
                "properties": {
                  "bom": {
                    "const": "sbom.cdx.json"
                  },
                  "components": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_checked": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "counts": {
                "type": "object",
                "required": [
                  "findings",
                  "by_section",
                  "held_back",
                  "facts"
                ],
                "properties": {
                  "findings": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "by_section": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "held_back": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "facts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "by_level": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "critical": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "high": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "medium": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "low": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "none": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "not_rated": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "usage": {
                "type": "object",
                "properties": {
                  "code_host_calls": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "vulnerability_database_calls": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "model_calls": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tokens_in": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tokens_out": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "$defs": {
              "Evidence": {
                "type": "object",
                "required": [
                  "file",
                  "line"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "description": "the line exactly as written at the commit, when it is at most 400 characters"
                  },
                  "long_line": {
                    "type": "integer",
                    "description": "the line's length, given instead of its text when it is longer than 400 characters"
                  }
                }
              },
              "Source": {
                "type": "object",
                "required": [
                  "system",
                  "call"
                ],
                "additionalProperties": false,
                "properties": {
                  "system": {
                    "enum": [
                      "code-host",
                      "vulnerability-database",
                      "text-reasoning"
                    ]
                  },
                  "call": {
                    "type": "string",
                    "description": "the read-only call the fact came from, such as GET /repos/{owner}/{name}"
                  },
                  "field": {
                    "type": "string"
                  }
                }
              },
              "Category": {
                "type": "object",
                "required": [
                  "list",
                  "id",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "list": {
                    "enum": [
                      "owasp-top-10-llm-2025",
                      "owasp-top-10-agentic",
                      "spdx-license-list",
                      "cyclonedx-1.5",
                      "osv"
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Finding": {
                "type": "object",
                "required": [
                  "id",
                  "section",
                  "kind",
                  "title",
                  "says",
                  "by",
                  "based_on"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^S[1-8]-[0-9]{3,}$"
                  },
                  "section": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "kind": {
                    "enum": [
                      "glance",
                      "repository",
                      "commit",
                      "publisher",
                      "license",
                      "built-on",
                      "activity",
                      "job",
                      "skill",
                      "part",
                      "input",
                      "output",
                      "model",
                      "how-it-runs",
                      "memory",
                      "human-step",
                      "system",
                      "credential",
                      "spend",
                      "tool",
                      "autonomy",
                      "risk",
                      "least-access",
                      "approval",
                      "test",
                      "test-gap",
                      "could-not-tell",
                      "question",
                      "not-judged"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "says": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Evidence"
                    }
                  },
                  "source": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Source"
                    }
                  },
                  "by": {
                    "enum": [
                      "script",
                      "model"
                    ]
                  },
                  "based_on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^F[0-9]{4,}$"
                    }
                  },
                  "level": {
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "level_by": {
                    "enum": [
                      "source",
                      "rule",
                      "model"
                    ],
                    "description": "who set the level: the record it came from (OSV), a fixed rule of Inspect's (a committed credential is high), or the model"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Category"
                    }
                  },
                  "repeats": {
                    "type": "string",
                    "pattern": "^S[2-8]-[0-9]{3,}$"
                  },
                  "detail": {
                    "type": "object",
                    "description": "fields of the finding's kind: a skill's name, path, scripts and lift_out (yes or no) with the imports that keep it from standing alone; a model's name, where it is chosen and whether a setting changes it; a system's name, host, access (read, write, read-write or unknown) and the credentials it expects; a tool's name, what it does and whether it runs without a person's OK; a vulnerability's package, version, OSV id, aliases and fixed version"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "evidence"
                    ],
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              },
              "Fact": {
                "type": "object",
                "required": [
                  "id",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^F[0-9]{4,}$"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string"
                  },
                  "long_line": {
                    "type": "integer"
                  },
                  "source": {
                    "$ref": "#/$defs/Source"
                  },
                  "data": {
                    "type": "object"
                  }
                }
              },
              "FindingSoFar": {
                "type": "object",
                "description": "a finding in the working copy: its id, place, title and level, the first place it cites, and its words where they fit",
                "required": [
                  "id",
                  "section",
                  "kind",
                  "title",
                  "by"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^S[1-8]-[0-9]{3,}$"
                  },
                  "section": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "kind": {
                    "enum": [
                      "glance",
                      "repository",
                      "commit",
                      "publisher",
                      "license",
                      "built-on",
                      "activity",
                      "job",
                      "skill",
                      "part",
                      "input",
                      "output",
                      "model",
                      "how-it-runs",
                      "memory",
                      "human-step",
                      "system",
                      "credential",
                      "spend",
                      "tool",
                      "autonomy",
                      "risk",
                      "least-access",
                      "approval",
                      "test",
                      "test-gap",
                      "could-not-tell",
                      "question",
                      "not-judged"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "says": {
                    "type": "string",
                    "minLength": 1
                  },
                  "by": {
                    "enum": [
                      "script",
                      "model"
                    ]
                  },
                  "level": {
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "level_by": {
                    "enum": [
                      "source",
                      "rule",
                      "model"
                    ],
                    "description": "who set the level: the record it came from (OSV), a fixed rule of Inspect's (a committed credential is high), or the model"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Category"
                    }
                  },
                  "repeats": {
                    "type": "string",
                    "pattern": "^S[2-8]-[0-9]{3,}$"
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 1,
                    "items": {
                      "$ref": "#/$defs/Evidence"
                    }
                  },
                  "more_evidence": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "how many more places the finding cites in the delivered report"
                  },
                  "source": {
                    "type": "array",
                    "maxItems": 1,
                    "items": {
                      "$ref": "#/$defs/Source"
                    }
                  }
                }
              }
            },
            "anyOf": [
              {
                "description": "the delivered report",
                "properties": {
                  "findings": {
                    "items": {
                      "$ref": "#/$defs/Finding"
                    }
                  }
                }
              },
              {
                "description": "the working copy",
                "required": [
                  "partial"
                ],
                "properties": {
                  "findings": {
                    "items": {
                      "$ref": "#/$defs/FindingSoFar"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "name": "inspection-md",
          "kind": "text/markdown",
          "when": "per_task",
          "presentation": "document",
          "about": "The same report as Markdown, for a person to read: `# Inspection of <repository>`, then `## At a glance`, then `## <section title>` for sections 2 to 8, one line per finding with its level in words, its category in words and its file and line at the commit, and no finding code."
        }
      ],
      "how": {
        "control": "script",
        "intelligence": "called",
        "cost": "metered",
        "contract": "full"
      },
      "example": {
        "inputs": {
          "repository": "https://github.com/langchain-ai/design-agent",
          "commit": "86d8f667796890eb6d3612dbd1b9e941782fe03f"
        },
        "good_result": "A report in eight sections on what the agent does and how safe it is, each finding citing a file and line at that commit, with its risks rated by level."
      }
    }
  ],
  "refusals": "Running, installing, building or testing the repository's code, because Inspect only reads it; it says so and inspects without running anything.\nGiving a verdict on whether to bring the agent in, or judging how it fits a plan or a catalog role, because that decision is the reader's; it says so and still delivers the report.\nA branch or a tag in place of a commit, because a branch or a tag can move and the report must stand for one commit; it asks for the commit's digest and inspects nothing.\nA repository that is not public on GitHub, or a commit that is not in it, because there is nothing it may read; it says which, and inspects nothing.\nAn archive larger than 50 MB or holding more than 20000 files, because it reads no more than that; it says how large the archive is, and inspects nothing.\nWriting a link from the archive, or a file whose path leaves its own folder, because an archive from somebody else must not decide where a file lands; it records each one as a fact and writes neither.\nRepeating the characters of anything that looks like a committed credential, because a report that repeats a key has published it; it keeps only the file, the line and the kind of credential.",
  "records": [
    {
      "name": "the signed job manifest of each delivery",
      "when": "per_task"
    }
  ],
  "systems": [
    {
      "name": "code-host",
      "access": "read",
      "needs": "To read the public repository's record, the commit's record, its recent commits and the archive of the repository at the commit from api.github.com, with GET requests only and no key."
    },
    {
      "name": "vulnerability-database",
      "access": "read",
      "needs": "To ask api.osv.dev which exact versions of the dependencies have known vulnerabilities, by queries that change nothing, and to read the record of each one found."
    },
    {
      "name": "text-reasoning",
      "access": "trigger",
      "needs": "To write the judgments over the facts the scripts found: what the agent does, how it works, what it can do on its own, its risks and what it needs to run safely, and the few findings that matter most."
    }
  ],
  "can_use": [
    {
      "schema": "https://schemas.agentmesh.ai/brand/v1",
      "reads": [
        "name",
        "legal.first_mention",
        "words.instead_of",
        "words.never_say",
        "palette.ink",
        "palette.ground",
        "palette.heading",
        "palette.accent",
        "type.heading.family",
        "type.body.family",
        "logo.mark.href"
      ],
      "required": false,
      "does": "writes the organization's name as the brand writes it, uses its first-mention form the first time, and keeps out the words the brand never says; and draws in the brand's colors and faces and places its mark",
      "without": "writes the organization's name as the person gave it, and says that no brand profile was given; and draws in this agent's own plain house style, and says that no brand profile was given"
    },
    {
      "schema": "https://schemas.agentmesh.ai/style-guide/v1",
      "reads": [
        "voice",
        "tone",
        "spelling",
        "words.prefer",
        "words.avoid"
      ],
      "required": false,
      "does": "writes in the organization's voice, tone and spelling, and uses the words it prefers in place of the ones it avoids",
      "without": "writes in a plain, neutral voice in the spelling of the words it was given, and says that no style guide was given"
    }
  ],
  "views": [
    {
      "id": "report",
      "for": {
        "offering": "inspect-a-repository",
        "output": "inspection"
      },
      "file": "views/report.html",
      "digest": "sha256:9586aef0be079d7364f41265b46ae22e23b9149c4c0802b5bbd5a7bcdd159d0e",
      "requests": [
        "resize",
        "copy-text",
        "save-file"
      ]
    }
  ]
}
