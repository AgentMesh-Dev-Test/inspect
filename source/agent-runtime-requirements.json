{
  "format": "agent-runtime-requirements-v1",
  "runtimes": [
    {
      "name": "node"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [
    {
      "name": "code-host",
      "kind": "service",
      "settings": [
        {
          "env": "GITHUB_API",
          "purpose": "where GitHub's API answers, its base address"
        }
      ]
    },
    {
      "name": "vulnerability-database",
      "kind": "service",
      "settings": [
        {
          "env": "OSV_API",
          "purpose": "where the OSV API answers, its base address"
        }
      ]
    },
    {
      "name": "text-reasoning",
      "kind": "model",
      "protocols": [
        "anthropic-messages",
        "openai-chat",
        "gemini"
      ]
    }
  ],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "every record the descriptor names"
    },
    {
      "name": "work",
      "purpose": "inputs and drafts in progress"
    }
  ],
  "job_seconds": 900,
  "price": {
    "sku": "default",
    "covers": {
      "agent": true
    },
    "price": {
      "model": "free"
    }
  },
  "run": {
    "inspect-a-repository": {
      "command": [
        "node",
        "{home}/{package}/skills/inspect-a-repository/scripts/inspect-a-repository.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "message_file": "{job_dir}/message.txt"
    }
  }
}
