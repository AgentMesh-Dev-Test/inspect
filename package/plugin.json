{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "inspect",
  "version": "0.1.2",
  "description": "Inspect reads an outside agent's code in a public GitHub repository at one commit, without running any of it, and hands back an inspection report on what the agent does and how safe it is: a list of findings in eight sections, each citing a file and line at the commit. Scripts collect the facts; a model writes only the judgments, and each judgment cites the facts it rests on. It gives no verdict on bringing the agent in and judges no fit with anyone's plan.",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "inspect-a-repository"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "inspect-a-repository": {
            "scripts": [
              "scripts/inspect-a-repository.mjs",
              "scripts/emit.mjs",
              "scripts/request.mjs",
              "scripts/github.mjs",
              "scripts/untar.mjs",
              "scripts/collect.mjs",
              "scripts/agent-facts.mjs",
              "scripts/deps.mjs",
              "scripts/judge.mjs",
              "scripts/checks.mjs",
              "scripts/report.mjs",
              "scripts/lists.mjs",
              "scripts/facts.mjs",
              "scripts/codebase.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs",
              "scripts/declarations.mjs",
              "scripts/flags.mjs",
              "scripts/sbom.mjs",
              "scripts/evidence.mjs",
              "scripts/secrets.mjs",
              "scripts/trace-programs.mjs",
              "scripts/model-caller.mjs"
            ]
          }
        }
      },
      "descriptor": {
        "path": "agent-descriptor.json",
        "sha256": "fa4f07d11e093d155707418a7c0b8909c8fd1b87929847dcfd7ae9c7a3472df7"
      },
      "runtime_requirements": {
        "path": "agent-runtime-requirements.json",
        "sha256": "8fd150c5383f195a4f08df33de46b5a4f19f599b6e34a3b7a56c4448e58c833e"
      },
      "built": true,
      "draft": true
    }
  }
}
