{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "inspect",
  "version": "0.2.7",
  "description": "Inspect reads an outside agent's code in a public GitHub repository at one commit, without running any of it, and hands back an inspection report on what the agent does and how safe it is: a list of findings in eight sections, each citing a file and line at the commit. Scripts read the code by rule; a model writes only the judgments, and each judgment cites the lines it rests on. It gives no verdict on bringing the agent in and judges no fit with anyone's plan.",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "inspect-a-repository"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "inspect-a-repository": {
            "scripts": [
              "scripts/inspect-a-repository.mjs",
              "scripts/emit.mjs",
              "scripts/request.mjs",
              "scripts/github.mjs",
              "scripts/untar.mjs",
              "scripts/collect.mjs",
              "scripts/agent-facts.mjs",
              "scripts/deps.mjs",
              "scripts/judge.mjs",
              "scripts/checks.mjs",
              "scripts/report.mjs",
              "scripts/lists.mjs",
              "scripts/facts.mjs",
              "scripts/codebase.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs",
              "scripts/declarations.mjs",
              "scripts/flags.mjs",
              "scripts/sbom.mjs",
              "scripts/evidence.mjs",
              "scripts/secrets.mjs",
              "scripts/trace-programs.mjs",
              "scripts/model-caller.mjs"
            ]
          }
        }
      },
      "descriptor": {
        "path": "agent-descriptor.json",
        "sha256": "269ceff6c9b82a9149a763a65abaaf80915cb1bbcdc3eb00b4b0910ffccd3c2d"
      },
      "runtime_requirements": {
        "path": "agent-runtime-requirements.json",
        "sha256": "8fd150c5383f195a4f08df33de46b5a4f19f599b6e34a3b7a56c4448e58c833e"
      },
      "built": true,
      "draft": true
    }
  }
}
